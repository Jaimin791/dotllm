{
    "name": "dotai",
    "version": "1.0.0",
    "description": "Auto-generate AI-ready context files from any codebase. Produces AI_CODING_RULES.md and AI_PROJECT_CONTEXT.md for LLM consumption in Cursor, Copilot, and ChatGPT.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "dotai": "./dist/cli/index.js",
        "ctx": "./dist/cli/index.js"
    },
    "files": [
        "dist",
        "scripts"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write src/**/*.ts",
        "test": "vitest",
        "test:run": "vitest run",
        "prepublishOnly": "npm run build",
        "postinstall": "node scripts/postinstall.js || exit 0"
    },
    "keywords": [
        "ai",
        "llm",
        "context",
        "codebase",
        "cursor",
        "copilot",
        "chatgpt",
        "devtools",
        "cli",
        "code-analysis",
        "developer-tools",
        "ai-assistant",
        "project-context",
        "coding-rules"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Jaimin791/dotai.git"
    },
    "homepage": "https://github.com/Jaimin791/dotai#readme",
    "bugs": {
        "url": "https://github.com/Jaimin791/dotai/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "commander": "^12.1.0",
        "chalk": "^5.3.0",
        "glob": "^10.3.10",
        "yaml": "^2.3.4",
        "toml": "^3.0.0",
        "ora": "^8.0.1"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3",
        "vitest": "^1.2.0",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "prettier": "^3.2.4"
    }
}